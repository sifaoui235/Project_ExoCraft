# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret utilisé pour signer et vérifier les tokens JWT
# Remplacer par une chaîne aléatoire longue et sécurisée en production
JWT_SECRET=votre_secret_jwt_a_changer

# Durée de validité des tokens JWT (ex: 1d, 8h, 30m)
JWT_EXPIRATION=1d

# ─── Serveur ──────────────────────────────────────────────────────────────────
# Port d'écoute du serveur NestJS
PORT=3000

# ─── IA (OpenRouter) ──────────────────────────────────────────────────────────
# Clé API OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-votre_cle_api_openrouter

# Modèle IA à utiliser (ex: meta-llama/llama-3.3-70b-instruct, openai/gpt-4o)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
